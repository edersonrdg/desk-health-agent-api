# Copy to .env (git-ignored) before running `docker compose up -d`.
# Dev-only placeholders: never put real credentials here.
POSTGRES_USER=desk_health
POSTGRES_PASSWORD=desk_health_dev
POSTGRES_DB=desk_health

# Optional: connection targets for the api (defaults shown).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# Field encryption (AES-256-GCM) and national ID blind index (HMAC-SHA256) keys:
# base64 of exactly 32 bytes each. Dev-only values: generate real ones with
# `openssl rand -base64 32` and never reuse these outside local development.
ENCRYPTION_KEY=morPaTWVTGsmqlJqAaBkS3s7ySH8cgLHEb6B9e9094U=
NATIONAL_ID_HMAC_KEY=Mhs58Rj4l4TMIUxHvLZPnFlhSEmcwj9q2kQYNOJBPB0=

# Optional: shared secret Evolution API sends in the `x-webhook-secret` header
# (set it in the instance's webhook headers). Unset: the webhook answers 503.
EVOLUTION_WEBHOOK_SECRET=dev-webhook-secret-change-me
